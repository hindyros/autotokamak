# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local

# Cloned repos
OpenFUSIONToolkit/
ursa/

# Personal notes / RA study materials (not part of the public repo)
TUTORIAL.md
ra_next_steps.md
notes/
*.scratch.md

# Run outputs (generated, never commit)
outputs/

# Pipeline level outputs — examples/<workspace>/<level>/ are live run artifacts
examples/*/fast/
examples/*/ursa/
examples/*/L0/
examples/*/L1/
examples/*/L2-*/

# URSA runtime scratch (created inside agent workspaces)
graph_store.sqlite
ursa_metrics/

# Agent-run logs
logs/

# Per-run experiment artifacts (generated; track structure via .gitkeep only)
experiments/*
!experiments/.gitkeep

# Heavy run artifacts inside example workspaces (stay on disk, never commit)
examples/**/*.h5
examples/**/*.pkl
examples/surrogate_meta/datasets/
examples/surrogate_meta/iterations/
examples/surrogate_meta/refits/
examples/surrogate_meta/surrogate_runs/
examples/surrogate_meta/meta_trace.json
examples/surrogate_meta/report.json

# Notebook run outputs
notebooks/manual_surrogate_run/
notebooks/scaling_runs/
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Single-prompt capability-test workspaces (generated at run time)
just_ursa/workspace/
just_dspy/workspace/

# Benchmark run artifacts (generated at run time; heavy assets stay on disk)
benchmarks/assets/*.h5
benchmarks/reference_runs/
