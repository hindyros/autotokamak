# Copy to .env (gitignored). Only the keys for the substrates you run are needed.

# URSA + DSPy harnesses, and the L1 DSPy typed pickers (init_chat_model / litellm)
OPENAI_API_KEY=sk-...

# claude_sdk harness (Claude Agent SDK), and pi with --provider anthropic
ANTHROPIC_API_KEY=sk-ant-...

# cursor harness (alternative: interactive `cursor-agent login` once)
CURSOR_API_KEY=...
